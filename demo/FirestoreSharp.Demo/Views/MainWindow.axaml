<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FirestoreSharp.Demo.ViewModels"
        x:Class="FirestoreSharp.Demo.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="FirestoreSharp Demo — Todos"
        Width="960" Height="600"
        MinWidth="700" MinHeight="400">

    <DockPanel Margin="8">

        <!-- Status bar at the bottom -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding StatusText}"
                   Margin="0,6,0,0"
                   FontSize="12"
                   Foreground="Gray" />

        <Grid ColumnDefinitions="240,8,*,8,280">

            <!-- ═══ LEFT: Master list ═══ -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Todos" FontWeight="Bold" FontSize="16" Margin="0,0,0,6" />

                <!-- Add row -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right"
                            Content="Add"
                            Command="{Binding AddCommand}"
                            Margin="4,0,0,0" />
                    <TextBox Text="{Binding NewTitle, Mode=TwoWay}"
                             Watermark="New todo title…" />
                </DockPanel>

                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TodoItemViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox IsChecked="{Binding Completed}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

            <!-- ═══ CENTER: Detail pane ═══ -->
            <Border Grid.Column="2"
                    BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="12">
                <DockPanel IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Save" Command="{Binding SaveCommand}" />
                        <Button Content="Delete" Command="{Binding DeleteCommand}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Title" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedItem.Title, Mode=TwoWay}" />

                        <TextBlock Text="Body" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedItem.Body, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 MinHeight="100"
                                 TextWrapping="Wrap" />

                        <CheckBox Content="Completed"
                                  IsChecked="{Binding SelectedItem.Completed, Mode=TwoWay}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent" />

            <!-- ═══ RIGHT: Activity log ═══ -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="Activity Log" FontWeight="Bold" FontSize="16" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding ActivityLog}"
                         FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                         FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

        </Grid>
    </DockPanel>
</Window>
